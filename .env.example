# Copy to .env (never commit .env). Values below are for LOCAL DEVELOPMENT ONLY.
DATABASE_URL="postgresql://platform:platform_dev_only@localhost:5432/platform?schema=public"
# Integration tests (audit chain, triggers) run against a separate schema and RESET it.
TEST_DATABASE_URL="postgresql://platform:platform_dev_only@localhost:5432/platform?schema=test"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Mock SSO lets you sign in as any seeded user without a password.
# It is hard-disabled when NODE_ENV=production regardless of this flag.
MOCK_SSO_ENABLED="true"
