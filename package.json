{
  "name": "internal-tools-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:actions": "tsx scripts/check-actions.ts",
    "check:schema": "tsx scripts/check-schema.ts",
    "check:audit": "tsx scripts/check-npm-audit.ts",
    "check:tool-request-scope": "tsx scripts/check-tool-request-scope.ts",
    "check": "npm run typecheck && npm run lint && npm run check:actions && npm run check:schema && npm run test",
    "db:migrate": "prisma migrate dev",
    "seed": "prisma migrate deploy && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.3.2",
    "next": "^14.2.35",
    "next-auth": "^4.24.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/eslint": "^8.56.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "deepmerge-ts": "^8.0.2",
    "@next/eslint-plugin-next": {
      "glob": "^14.0.4"
    }
  }
}
